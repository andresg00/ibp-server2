{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization, accessKey, accesskey" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/document",
      "destination": "/api/firebase?route=get-document"
    },
    {
      "source": "/api/collection",
      "destination": "/api/firebase?route=get-list"
    },
    {
      "source": "/api/get-document",
      "destination": "/api/firebase?route=get-document"
    },
    {
      "source": "/api/get-list",
      "destination": "/api/firebase?route=get-list"
    },
    {
      "source": "/api/get-first-document",
      "destination": "/api/firebase?route=get-first-document"
    },
    {
      "source": "/api/get-last-document",
      "destination": "/api/firebase?route=get-last-document"
    },
    {
      "source": "/api/get-my-projects",
      "destination": "/api/firebase?route=get-my-projects"
    },
    {
      "source": "/api/verify-project-ownership",
      "destination": "/api/firebase?route=verify-project-ownership"
    },
    {
      "source": "/api/claim-project",
      "destination": "/api/firebase?route=claim-project"
    },
    {
      "source": "/api/unclaim-project",
      "destination": "/api/firebase?route=unclaim-project"
    },
    {
      "source": "/api/set-document",
      "destination": "/api/firebase?route=set-document"
    },
    {
      "source": "/api/set-list",
      "destination": "/api/firebase?route=set-list"
    },
    {
      "source": "/api/generate-upload-url",
      "destination": "/api/storage?route=generate-upload-url"
    },
    {
      "source": "/api/delete-file",
      "destination": "/api/storage?route=delete-file"
    },
    {
      "source": "/api/check-media",
      "destination": "/api/storage?route=check-media"
    },
    {
      "source": "/api/get-album-images",
      "destination": "/api/storage?route=get-album-images"
    },
    {
      "source": "/api/search-materials",
      "destination": "/api/materials?route=search-materials"
    },
    {
      "source": "/api/update-material",
      "destination": "/api/materials?route=update-material"
    },
    {
      "source": "/api/calculate-match",
      "destination": "/api/match?route=calculate-match"
    },
    {
      "source": "/api/get-compatible-lotes",
      "destination": "/api/match?route=get-compatible-lotes"
    },
    {
      "source": "/api/get-compatible-designs",
      "destination": "/api/match?route=get-compatible-designs"
    },
    {
      "source": "/api/get-weather",
      "destination": "/api/weather"
    },
    {
      "source": "/api/get-weather-history",
      "destination": "/api/weather-history"
    },
    {
      "source": "/api/ai-description",
      "destination": "/api/ai?route=description"
    },
    {
      "source": "/api/ai-execute",
      "destination": "/api/ai?route=execute"
    },
    {
      "source": "/api/ai-reformulate",
      "destination": "/api/ai?route=reformulate"
    },
    {
      "source": "/api/apply",
      "destination": "/api/apply?route=apply"
    },
    {
      "source": "/api/admin/simulate-response",
      "destination": "/api/apply?route=simulate-response"
    },
    {
      "source": "/api/reviews",
      "destination": "/api/reviews"
    },
    {
      "source": "/api/register",
      "destination": "/api/auth?route=register"
    },
    {
      "source": "/api/login",
      "destination": "/api/auth?route=login"
    },
    {
      "source": "/api/logout",
      "destination": "/api/auth?route=logout"
    },
    {
      "source": "/",
      "destination": "/api/index"
    }
  ]
}
